{
    "name": "beamfinds",
    "version": "2.1.4",
    "description": "BeamFinds Mod Downloader for BeamNG.drive",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "vite build && electron-builder --win",
        "build:linux": "vite build && electron-builder --linux",
        "dev": "vite",
        "build:vite": "vite build"
    },
    "author": "BeamFinds",
    "license": "MIT",
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.1",
        "@vitejs/plugin-react": "^4.3.4",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "vite": "^5.4.11"
    },
    "dependencies": {
        "adm-zip": "^0.5.10",
        "discord-rpc": "^4.0.1",
        "electron-store": "^8.1.0",
        "framer-motion": "^12.35.2",
        "node-stream-zip": "^1.15.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zustand": "^5.0.11"
    },
    "build": {
        "appId": "com.beamfinds.app",
        "productName": "BeamFinds",
        "icon": "build/icon.ico",
        "files": [
            "**/*",
            "!**/*.test.js",
            "!node_modules/register-scheme/**/*"
        ],
        "asarUnpack": [
            "handlers/conflicts/**"
        ],
        "directories": {
            "buildResources": "build"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico",
            "signAndEditExecutable": true
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "BeamFinds"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "build/icon.png",
            "category": "Utility"
        },
        "protocols": {
            "name": "BeamFinds Protocol",
            "schemes": [
                "beamfinds"
            ]
        }
    }
}
